# Modèle de configuration de l'application Next.js.
# Copier vers .env.local puis renseigner des valeurs réelles.
# La validation Zod au démarrage (lib/env.ts) fait échouer le process
# si une variable requise manque ou est mal formée.

# --- Base de données (PostgreSQL 17 + pgvector) ---
# Hébergée chez Supabase en dev/prod ; pooler (port 6543, pgbouncer)
# pour le runtime, connexion directe (5432) pour les migrations Drizzle.
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# --- Meilisearch ---
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=changeme_min_16_caracteres

# --- Valkey / Redis ---
REDIS_URL=redis://:password@localhost:6379

# --- MinIO (S3) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=helleilla_admin
MINIO_ROOT_PASSWORD=changeme_min_8_caracteres
MINIO_BUCKET=helleilla-media

# --- Better Auth ---
# Secret de signature des sessions (min. 32 caractères) :
#   openssl rand -base64 32
BETTER_AUTH_SECRET=changeme_min_32_caracteres
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Compte administrateur initial (scripts/seed-admin.ts) ---
ADMIN_EMAIL=admin@helleilla.local
ADMIN_PASSWORD=changeme_min_12_caracteres

# --- Médias externes (providers) ---
# Token API Discogs (photos/bio). Optionnel : sans token, le provider
# est simplement désactivé (aucun crash).
DISCOGS_TOKEN=

# --- Base identité dédiée (RGPD) ---
# Projet Supabase DISTINCT hébergeant user/session/account/verification.
# Tant que cette variable est vide, l'auth bascule sur DATABASE_URL
# (mode mono-base). Migration : pnpm migrate:auth-db
AUTH_DATABASE_URL=

# --- Cloudflare Turnstile (CAPTCHA inscription) ---
# Créer un widget sur https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Base identité dédiée (RGPD) ---
AUTH_DATABASE_URL=

# --- SMTP transactionnel (reset password) ---
# Sans configuration : le lien de reset est journalisé en console (dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@helleilla.local
