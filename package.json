{
  "name": "helleilla_exploratium",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "minio:init": "tsx --env-file=.env.local scripts/init-minio.ts",
    "meili:init": "tsx --env-file=.env.local scripts/init-meili.ts",
    "test:db": "tsx --env-file=.env.local scripts/test-db.ts",
    "workers": "tsx --env-file=.env.local scripts/start-workers.ts",
    "smoke": "tsx --env-file=.env.local scripts/smoke-test.ts",
    "seed:admin": "tsx --env-file=.env.local scripts/seed-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@base-ui/react": "^1.7.0",
    "@node-rs/argon2": "^2.1.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.10",
    "better-auth": "^1.7.1",
    "bullmq": "^6.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.33.0",
    "meilisearch": "^0.60.0",
    "motion": "^13.1.1",
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
