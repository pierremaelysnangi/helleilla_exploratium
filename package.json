{
  "name": "helleilla_exploratium",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate:auth": "drizzle-kit generate --config=drizzle.auth.config.ts",
    "db:migrate:auth": "drizzle-kit migrate --config=drizzle.auth.config.ts",
    "migrate:auth-db": "tsx --env-file=.env.local scripts/migrate-auth-db.ts",
    "minio:init": "tsx --env-file=.env.local scripts/init-minio.ts",
    "meili:init": "tsx --env-file=.env.local scripts/init-meili.ts",
    "test:db": "tsx --env-file=.env.local scripts/test-db.ts",
    "workers": "tsx --env-file=.env.local scripts/start-workers.ts",
    "smoke": "tsx --env-file=.env.local scripts/smoke-test.ts",
    "seed:admin": "tsx --env-file=.env.local scripts/seed-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "e2e:services": "docker compose -f docker-compose.test.yml up -d --wait",
    "e2e:services:down": "docker compose -f docker-compose.test.yml down -v",
    "test:e2e": "vitest run --config vitest.config.e2e.mts",
    "test:e2e:full": "pnpm e2e:services && pnpm test:e2e; status=$?; pnpm e2e:services:down; exit $status",
    "prepare": "husky",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "openapi:lint": "pnpm openapi:export && redocly lint openapi/openapi.json",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:cov && pnpm openapi:lint",
    "seed:demo": "tsx --env-file=.env.local scripts/seed-demo.ts",
    "search:reindex": "tsx --env-file=.env.local scripts/reindex-search.ts",
    "media:sync": "tsx --env-file=.env.local scripts/sync-media.ts",
    "dedupe:albums": "tsx --env-file=.env.local scripts/dedupe-albums.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@base-ui/react": "^1.7.0",
    "@node-rs/argon2": "^2.1.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.10",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "better-auth": "^1.7.1",
    "bullmq": "^6.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.33.0",
    "meilisearch": "^0.60.0",
    "motion": "^13.1.1",
    "next": "16.3.2",
    "nodemailer": "^9.0.5",
    "nuqs": "^2.10.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ripgrep": "^0.3.1",
    "shadcn": "^4.19.0",
    "swagger-ui-dist": "^5.32.14",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zod-openapi": "^6.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.47.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/swagger-ui-dist": "^3.30.6",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compat": "^0.1.7",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.22.0",
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "safari >= 16.4",
    "firefox >= 128",
    "not dead"
  ]
}
