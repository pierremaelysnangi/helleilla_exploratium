# Modèle de configuration de la stack d'infrastructure de dev.
# Copier vers .env puis remplacer chaque valeur par un secret fort :
#   openssl rand -hex 32
# Ce fichier est committé ; le fichier .env réel est gitignore.

# --- Meilisearch ---
# Clé maître API (min. 16 caractères, validée par lib/env.ts)
MEILI_MASTER_KEY=changeme_openssl_rand_hex_32
MEILI_HOST=http://localhost:7700

# --- Valkey / Redis ---
# Mot de passe du serveur Valkey (requirepass) et URL complète consommée
# par l'application (lib/redis.ts)
REDIS_PASSWORD=changeme_openssl_rand_hex_32
REDIS_URL=redis://:changeme_openssl_rand_hex_32@localhost:6379

# --- MinIO ---
MINIO_ROOT_USER=helleilla_admin
MINIO_ROOT_PASSWORD=changeme_openssl_rand_hex_32
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=helleilla-media
